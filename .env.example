# Cloudflare Access (production required)
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUDIENCE=

# Server-side upstreams (production required)
SPONSOR_GATEWAY_ORIGIN=
SPONSOR_GATEWAY_ADMIN_TOKEN=
# Optional direct origin (no Cloudflare proxy) used when the primary is edge-blocked
SPONSOR_GATEWAY_DIRECT_ORIGIN=
TELEMETRY_ADMIN_ORIGIN=

# Axolotl Update Server
UPDATE_SERVER_ORIGIN=
# Bearer token for /api/admin/* (versions revoke/restore, stats, audit logs)
UPDATE_SERVER_ADMIN_TOKEN=
# Optional direct origin (no Cloudflare proxy) used when the primary is unreachable
UPDATE_SERVER_DIRECT_ORIGIN=

# Development only; never enable in production
AXOADMIN_MOCK_AUTH=false

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
